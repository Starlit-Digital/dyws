{
  "name": "@starlit-digital/dyws",
  "version": "0.4.0",
  "private": true,
  "description": "Reusable Do You Want Something ordering JavaScript and scoped CSS",
  "style": "dyws.css",
  "exports": {
    ".": "./index.js",
    "./tokens.css": "./tokens.css",
    "./catalog.css": "./catalog.css",
    "./ordering.css": "./ordering.css",
    "./admin.css": "./admin.css",
    "./tracking.css": "./tracking.css",
    "./index.js": "./index.js",
    "./component.js": "./component.js",
    "./cart.js": "./cart.js",
    "./catalog.js": "./catalog.js",
    "./api.js": "./api.js",
    "./tracking.js": "./tracking.js",
    "./storefront.js": "./storefront.js",
    "./manager.js": "./manager.js",
    "./driver.js": "./driver.js",
    "./settings.js": "./settings.js",
    "./dyws.css": "./dyws.css",
    "./admin-navigation.js": "./admin-navigation.js",
    "./catalog-editor.js": "./catalog-editor.js",
    "./account-editor.js": "./account-editor.js",
    "./stripe-editor.js": "./stripe-editor.js",
    "./role-labels.js": "./role-labels.js",
    "./general-settings.js": "./general-settings.js",
    "./driver-gps.js": "./driver-gps.js",
    "./realtime.js": "./realtime.js",
    "./google-maps.js": "./google-maps.js",
    "./gps-cache.js": "./gps-cache.js",
    "./maps-settings.js": "./maps-settings.js"
  },
  "files": [
    "*.js",
    "*.css",
    "README.md"
