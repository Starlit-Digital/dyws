[Unit]
Description=Update DYWS Alberta address data
After=postgresql@17-dyws.service network-online.target
Requires=postgresql@17-dyws.service

[Service]
Type=oneshot
User=dyws-nominatim
Group=dyws-nominatim
WorkingDirectory=/srv/dyws-nominatim/project
ExecStart=/srv/dyws-nominatim/venv/bin/nominatim replication --catch-up --threads 2 --osm2pgsql-cache 512 --socket-timeout 30
ExecStartPost=/srv/dyws-nominatim/venv/bin/python /srv/dyws-nominatim/service/refresh.py
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/dyws-nominatim/project
MemoryMax=4G
CPUQuota=150%
Nice=15
IOWeight=25
UMask=0027
