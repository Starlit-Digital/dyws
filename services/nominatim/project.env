NOMINATIM_DATABASE_DSN=pgsql:dbname=dyws_nominatim;host=/run/postgresql;port=5433
NOMINATIM_DATABASE_WEBUSER=dyws-geocoder
NOMINATIM_IMPORT_STYLE=full
NOMINATIM_REPLICATION_URL=https://download.geofabrik.de/north-america/canada/alberta-updates
NOMINATIM_REPLICATION_UPDATE_INTERVAL=86400
NOMINATIM_REPLICATION_RECHECK_INTERVAL=900
NOMINATIM_DEFAULT_LANGUAGE=en
NOMINATIM_SEARCH_WITHIN_COUNTRIES=ca
NOMINATIM_CORS_NOACCESSCONTROL=no
NOMINATIM_SERVE_LEGACY_URLS=no
NOMINATIM_SERVE_DEBUG_OUTPUT=no
NOMINATIM_API_POOL_SIZE=5
NOMINATIM_QUERY_TIMEOUT=5
NOMINATIM_REQUEST_TIMEOUT=10
NOMINATIM_LOG_FILE=
NOMINATIM_DEBUG_SQL=no
