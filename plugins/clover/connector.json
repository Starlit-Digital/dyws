{
  "id": "clover",
  "name": "Clover",
  "documentation": "https://docs.clover.com/dev/docs/hosted-checkout-api",
  "fields": [
    {
      "id": "accessToken",
      "label": "Sandbox private API token",
      "required": true,
      "secret": true
    },
    {
      "id": "merchantId",
      "label": "Merchant ID",
      "required": true,
      "secret": true
    },
    {
      "id": "webhookSecret",
      "label": "Hosted Checkout signing secret",
      "required": true,
      "secret": true
    }
  ],
  "operations": [
    "merchant.get",
    "checkout.create",
    "payment.get"
  ],
  "webhook": "/plugins/clover/webhook",
  "refundPolicy": {
    "checkedAt": "2026-10-27",
    "merchantNote": "Canada: fees depend on the signed merchant agreement. Confirm refund and processing fees with the account provider.",
    "source": "https://merchants.fiserv.com/content/dam/firstdata/ca/en/pdf/CA-Merchant-Terms.pdf",
    "customerDeduction": 0
  }
}
