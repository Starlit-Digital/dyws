{
  "id": "paypal",
  "name": "PayPal",
  "documentation": "https://developer.paypal.com/checkout/integrate",
  "fields": [
    {
      "id": "clientId",
      "label": "Sandbox client ID",
      "required": true,
      "secret": true
    },
    {
      "id": "clientSecret",
      "label": "Sandbox client secret",
      "required": true,
      "secret": true
    },
    {
      "id": "webhookId",
      "label": "Webhook ID",
      "required": true,
      "secret": true
    }
