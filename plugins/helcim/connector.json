{
  "id": "helcim",
  "name": "Helcim",
  "documentation": "https://devdocs.helcim.com/docs/initialize-helcimpayjs",
  "fields": [
    {
      "id": "apiToken",
      "label": "Developer test account API token",
      "required": true,
      "secret": true
    },
    {
      "id": "webhookSecret",
      "label": "Webhook verifier token",
      "required": true,
      "secret": true
    }
  ],
  "operations": [
    "terminals.list",
    "checkout.create",
    "transaction.get"
  ],
  "webhook": "/payments/hc/events",
  "refundPolicy": {
    "checkedAt": "2026-10-27",
    "merchantNote": "No additional refund fee. Original processing fees are retained. Voids before settlement can avoid processing fees.",
    "source": "https://www.helcim.com/pricing/",
    "customerDeduction": 0
  }
}
